    {
      "id": "s23-timeline",
      "type": "timeline",
      "narration": "智伯被杀，智氏全族被灭。那是公元前 453 年。五十年后，三家封侯，战国开场。",
      "estimatedDurationInFrames": 183,
      "events": [
        {
          "year": -453,
          "label": "三家灭智",
          "detail": "晋阳之战",
          "emphasis": true
        },
        {
          "year": -403,
          "label": "三家封侯",
          "detail": "周威烈王命为诸侯",
          "emphasis": true
        }
      ],
      "activeIndex": 1,
      "transition": {
        "type": "fade",
        "durationInFrames": 12
      }
    },
    {
      "id": "s24-caide",
      "type": "quote",
      "narration": "司马光总结说：“智伯之亡也，才胜德也。”又说：“才者，德之资也；德者，才之帅也。”才能是德的凭借，德是才能的统帅。",
      "estimatedDurationInFrames": 280,
      "text": "智伯之亡也，才胜德也。才者，德之资也；德者，才之帅也。",
      "source": "《资治通鉴》卷第一·周纪一",
      "attribution": "司马光",
      "layout": "vertical",
      "transition": {
        "type": "scroll",
        "durationInFrames": 18
      }
    },
    {
      "id": "s25-tiger",
      "type": "narration",
      "narration": "找不到圣人和君子，“与其得小人，不若得愚人”：愚人想干坏事，能力不够；小人既有脑子又有胆子，就是长了翅膀的老虎。",
      "estimatedDurationInFrames": 307,
      "heading": "虎而翼",
      "keywords": [
        "小人",
        "愚人"
      ],
      "background": "ink",
      "transition": {
        "type": "fade",
        "durationInFrames": 12
      }
    },
    {
      "id": "s26-modern",
      "type": "narration",
      "narration": "开篇讲名分，结尾讲才德，说到底是一回事。用人、教育孩子，顺序都一样：先问该不该，再问能不能；先立德，再长才。",
      "estimatedDurationInFrames": 287,
      "heading": "先立德，再长才",
      "keywords": [
        "用人",
        "教育",
        "才德"
      ],
      "background": "paper",
      "transition": {
        "type": "fade",
        "durationInFrames": 12
      }
    }
  ]
