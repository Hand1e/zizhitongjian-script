      }
    },
    {
      "id": "s22b-alliance",
      "type": "relation",
      "narration": "智伯军忙着救水，阵脚大乱；韩、魏两翼夹击，赵襄子正面冲杀。",
      "estimatedDurationInFrames": 157,
