{
  "name": "zztj-animation",
  "version": "0.1.0",
  "private": true,
  "description": "资治通鉴故事讲解动画（Remotion + TypeScript）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "render": "tsx scripts/render.ts",
    "still": "remotion still",
    "tts": "python scripts/tts.py",
    "timeline": "tsx scripts/build-timeline.ts",
    "verify": "tsx scripts/verify-render.ts",
    "check:frames": "python scripts/check-frames.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.543",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
